# Root environment file for docker-compose.yml (Docker or Podman).
# Copy to `.env` and replace every CHANGE_ME value. NEVER commit `.env` (it is git-ignored).
# Comments are on their own lines on purpose: inline comments are parsed inconsistently.
#
# For running the backend WITHOUT Docker, use backend/.env (see backend/.env.example) instead.

# ---- PostgreSQL ---------------------------------------------------------------------------
POSTGRES_USER=fintasks
# Generate with: openssl rand -hex 16  (keep it URL-safe: it is placed inside DATABASE_URL)
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=fintasks
# Host port for local tools (bound to 127.0.0.1). Containers use postgres:5432 internally.
POSTGRES_PORT=5433

# ---- Backend ------------------------------------------------------------------------------
# development | production. "production" requires COOKIE_SECURE=true, which needs HTTPS.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Signing key for the access and refresh tokens. REQUIRED, at least 32 characters, never given to
# the frontend. Generate with: openssl rand -base64 48
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ISSUER=fintasks-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# false for plain http://localhost. Set true behind HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# The URL people open in the browser. If you change FRONTEND_PORT, change this to match.
ALLOWED_ORIGINS=http://localhost:3000
BACKEND_PORT=8000

# ---- Frontend -----------------------------------------------------------------------------
FRONTEND_PORT=3000
# Browser-side API base URL. Leave EMPTY (recommended): the browser calls /api/v1 on the frontend
# and the Next.js server forwards it to the backend container. No secrets: it is public.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_APP_NAME=Finbase Workdesk
