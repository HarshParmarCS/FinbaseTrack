# Root environment file, read by docker-compose.yml (Podman or Docker).
# Copy to `.env` and set a real password. NEVER commit `.env`.
# Generate a password with: openssl rand -hex 16
# Comments are on their own lines on purpose: inline comments are parsed inconsistently.
#
# The backend has its own file: backend/.env (see backend/.env.example).
# More variables (JWT secret, cookies, frontend, ports) are added in milestones M2, M8 and M13.

POSTGRES_USER=fintasks
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=fintasks
# Host port published on 127.0.0.1 (container port stays 5432).
POSTGRES_PORT=5433
