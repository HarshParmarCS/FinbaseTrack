# Frontend configuration. Copy to `.env.local`. Placeholders only: never commit real values.

# Where the Next.js server forwards /api/* requests (server side only, never sent to the browser).
BACKEND_INTERNAL_URL=http://localhost:8000

# Product name shown in the UI. NEXT_PUBLIC_* values are visible in the browser: no secrets here.
NEXT_PUBLIC_APP_NAME=Finbase Workdesk

# Base URL the BROWSER uses for API calls. Leave empty (recommended) to call /api/v1 on the frontend
# origin and let Next.js forward it to BACKEND_INTERNAL_URL. Set to http://localhost:8000 to call the
# backend directly (needs CORS; the frontend origin must be in the backend's ALLOWED_ORIGINS).
# No trailing slash. Visible in the browser: no secrets.
NEXT_PUBLIC_API_BASE_URL=
