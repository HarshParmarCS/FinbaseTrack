# Backend configuration. Copy to `.env` (same folder) and edit. Placeholders only: never commit real values.
# Comments are on their own lines on purpose.

# development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# PostgreSQL connection URL (required). Format:
# postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://fintasks:CHANGE_ME_PASSWORD@localhost:5433/fintasks

# Connection pool (optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ---- Authentication ----
# Signing key for access and refresh tokens. REQUIRED, at least 32 characters, never shared with the
# frontend. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ISSUER=fintasks-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Cookies, CSRF and CORS ----
# COOKIE_SECURE must be true in production (HTTPS); the app refuses to start otherwise.
COOKIE_SECURE=false
# lax | strict
COOKIE_SAMESITE=lax
# Leave empty for host-only cookies.
COOKIE_DOMAIN=
# Browser origins allowed to call the API with credentials and to send state-changing requests.
# Comma separated, scheme://host[:port], no trailing slash, never "*".
ALLOWED_ORIGINS=http://localhost:3000

# Authorization policy file (JSON). Relative paths are resolved against the backend directory.
# The application refuses to start if it is invalid or incomplete.
POLICY_FILE=app/authorization/policies.json

# Used only by the test suite (required to run pytest). The database name MUST end with `_test`;
# the tests refuse to run otherwise, so they cannot touch your development data.
TEST_DATABASE_URL=postgresql+psycopg://fintasks:CHANGE_ME_PASSWORD@localhost:5433/fintasks_test
