# Backend configuration. Copy to `.env` (same folder) and edit. Placeholders only: never commit real values.
# Comments are on their own lines on purpose.

# development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# PostgreSQL connection URL (required). Format:
# postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://fintasks:CHANGE_ME_PASSWORD@localhost:5433/fintasks

# Connection pool (optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Used only by the test suite (required to run pytest). The database name MUST end with `_test`;
# the tests refuse to run otherwise, so they cannot touch your development data.
TEST_DATABASE_URL=postgresql+psycopg://fintasks:CHANGE_ME_PASSWORD@localhost:5433/fintasks_test
